# ─────────────────────────────────────────────────────────────
#  DemoDrop — environment variables
#  Copy to `.env` and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Database
#   Local dev (default): SQLite file, zero setup.
#   Production: swap for a Postgres URL (Neon / Supabase / Railway)
#   and change `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# App
#   Public base URL of the deployment (used for Stripe redirects, OG, sitemap).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth
#   Long random string used to sign session JWTs.
#   Generate one with:  openssl rand -base64 48
AUTH_SECRET="dev-secret-change-me-in-production-please-32chars-min"

# Stripe (test mode keys are fine to start)
#   Get keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
#   From `stripe listen` or the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=""

# Optional: set to "1" to expose test-only helpers (dev seeding shortcuts).
DEMODROP_DEV_TOOLS="1"
