# ─────────────────────────────────────────────────────────────
#  SUPERNOVA — environment variables (all optional)
#  The game runs fully client-side with NO env vars at all.
#  These only turn on monetization + correct absolute URLs.
#  Copy to `.env.local` and fill in what you need.
# ─────────────────────────────────────────────────────────────

# Public base URL of your deployment (used for OG tags, sitemap, robots).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Supporter Pack (one-time purchase) ───────────────────────
# A Stripe Payment Link, Gumroad, or Lemon Squeezy checkout URL.
# On success, send buyers back to /play?supporter=success to unlock it.
# Leave blank in dev — the button then grants it locally for testing.
NEXT_PUBLIC_SUPPORTER_URL=""

# ── Ads (optional) ───────────────────────────────────────────
# Set to "1" once you've wired an ad network; keeps ad slots hidden until then.
NEXT_PUBLIC_ADS_ENABLED="0"
# Google AdSense publisher id, e.g. "ca-pub-0000000000000000".
NEXT_PUBLIC_ADSENSE_CLIENT=""

# ── Analytics (optional, privacy-friendly) ───────────────────
# Plausible — no cookies, GDPR-friendly. Leave blank to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
# Override if self-hosting Plausible.
NEXT_PUBLIC_PLAUSIBLE_SRC=""
