# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# testing
/coverage

# database (local SQLite — never commit real data)
*.db
*.db-journal
/prisma/*.db
/prisma/dev.db*

# env — never commit secrets
.env
.env*.local
.env.production

# misc
.DS_Store
*.pem
*.tsbuildinfo
.vercel

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editors
.idea
.vscode
